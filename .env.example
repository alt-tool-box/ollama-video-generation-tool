# Root .env - used by shared/python/config.py for MCP apps under apps/
# Lead-app has its own .env at main-app/lead-app/.env
# Each MCP app has its own .env at apps/mcp-*/.env
# Copy to .env and fill in your values

# Database (used by shared config; lead-app has its own)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/video_creation

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-creation
MINIO_SECURE=false

# Ollama (LLM for script generation)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b

# ComfyUI (motion video generation)
COMFYUI_URL=http://localhost:8188

# TTS (Coqui fallback model - ElevenLabs config is in apps/mcp-tts/.env)
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO