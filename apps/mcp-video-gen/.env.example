# MCP Video Gen - FFmpeg/MoviePy final video render
# Copy to .env and fill in your values

PORT=9004

# Background Music (optional - MinIO path to uploaded music file)
# Example: music/ambient_cinematic.mp3
BACKGROUND_MUSIC_PATH=
BACKGROUND_MUSIC_VOLUME=0.15

# MinIO (for downloading clips/audio, uploading final video)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-creation
MINIO_SECURE=false

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO