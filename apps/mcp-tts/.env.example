# MCP TTS - Text-to-speech (ElevenLabs primary, Coqui fallback)
# Copy to .env and fill in your values

PORT=9003

# ElevenLabs (primary TTS - ~10 min/month free tier)
# Leave ELEVENLABS_API_KEY empty to use Coqui only
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=7qBNUtXRGP0jPi0H4r8k
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Coqui XTTS v2 (local fallback when ElevenLabs unavailable)
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# MinIO (for uploading generated audio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-creation
MINIO_SECURE=false

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO