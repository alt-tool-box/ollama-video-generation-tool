# Lead App - FastAPI orchestrator
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/video_creation

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-creation
MINIO_SECURE=false

# App Ports
LEAD_APP_PORT=8000
WEB_UI_PORT=3000

# MCP Server URLs (HTTP SSE endpoints - must match MCP server ports)
MCP_SCRIPT_WRITER_URL=http://localhost:9001/sse
MCP_IMAGE_GEN_URL=http://localhost:9002/sse
MCP_TTS_URL=http://localhost:9003/sse
MCP_VIDEO_GEN_URL=http://localhost:9004/sse

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO